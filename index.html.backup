<!-- ════════════════════════ ROADMAP ════════════════════════ -->
<section id="roadmap" class="section">
  <div class="sec-wrap">
    <div class="sec-header">
      <div class="sec-tag">🗺️ 6-Month Plan</div>
      <h2 class="sec-title">AI Transformation <span>Roadmap</span></h2>
      <p class="sec-desc">A structured 6-month implementation plan with clear phases, participants, and deliverables — executed by all leaders at HKBK with consulting support from Mr. Rocky Jagtiani & team.</p>
    </div>

    <div class="roadmap-phases">

      <div class="phase-row">
        <div class="phase-label">
          <div class="phase-num">Phase 1</div>
          <h4>Faculty Training</h4>
          <div class="phase-period">Month 1</div>
        </div>
        <div class="phase-body">
          <p><strong>Focus:</strong> All faculty understand AI tools, learn Prompt Engineering, identify real problems in their work, and build + test actual prompts using real college documents.</p>
          <p style="margin-top:8px;"><strong>Participants:</strong> All Faculty across all departments</p>
          <div class="phase-deliverables">
            <span class="deliverable">25–30 Faculty Teams</span>
            <span class="deliverable">25–30 Problems Identified</span>
            <span class="deliverable">Prompt Library v1</span>
            <span class="deliverable">Prompts Tested on Real Docs</span>
          </div>
        </div>
      </div>

      <div class="phase-row">
        <div class="phase-label">
          <div class="phase-num">Phase 2</div>
          <h4>Faculty Pilot</h4>
          <div class="phase-period">Month 2</div>
        </div>
        <div class="phase-body">
          <p><strong>Focus:</strong> Selected departments pilot AI in real academic work — lesson plans, question papers, assignments, viva, and SSR writing using prompts they built.</p>
          <p style="margin-top:8px;"><strong>Pilot Departments:</strong> CS, IS, AIML/DS, ECE, MBA</p>
          <div class="phase-deliverables">
            <span class="deliverable">AI Lesson Plans</span>
            <span class="deliverable">AI Question Papers</span>
            <span class="deliverable">AI Assignments</span>
            <span class="deliverable">AI Viva Conducted</span>
            <span class="deliverable">Time Saved Report</span>
          </div>
        </div>
      </div>

      <div class="phase-row">
        <div class="phase-label">
          <div class="phase-num">Phase 3</div>
          <h4>Student Awareness</h4>
          <div class="phase-period">Month 3–4</div>
        </div>
        <div class="phase-body">
          <p><strong>Focus:</strong> Motivate and expose 2nd, 3rd, 4th year students to AI tools, career opportunities, and real project possibilities. Design Thinking workshop to convert problems into AI ideas.</p>
          <p style="margin-top:8px;"><strong>Topics:</strong> AI Awareness · Python · Colab · Hugging Face · APIs · GitHub · Design Thinking</p>
          <div class="phase-deliverables">
            <span class="deliverable">Student Awareness Sessions</span>
            <span class="deliverable">Tool Demos</span>
            <span class="deliverable">Problem→AI Idea Mapping</span>
          </div>
        </div>
      </div>

      <div class="phase-row">
        <div class="phase-label">
          <div class="phase-num">Phase 4</div>
          <h4>Student AI Projects</h4>
          <div class="phase-period">Month 4–5</div>
        </div>
        <div class="phase-body">
          <p><strong>Focus:</strong> Students work in teams of 3–4 with a faculty mentor to build real AI mini projects. Each team has a problem statement, dataset, working model, demo, report, and GitHub repo.</p>
          <p style="margin-top:8px;"><strong>Tools:</strong> Python · Google Colab · Hugging Face · Open-source models · Open datasets</p>
          <div class="phase-deliverables">
            <span class="deliverable">AI Project Culture</span>
            <span class="deliverable">GitHub Repos</span>
            <span class="deliverable">Working Model Demos</span>
            <span class="deliverable">Project Reports</span>
          </div>
        </div>
      </div>

      <div class="phase-row" style="border-color:rgba(244,196,48,.3);">
        <div class="phase-label" style="background:rgba(244,196,48,.06);border-right-color:rgba(244,196,48,.2);">
          <div class="phase-num" style="color:var(--gold);">Phase 5</div>
          <h4>Institutionalization</h4>
          <div class="phase-period">Month 6</div>
        </div>
        <div class="phase-body">
          <p><strong>Focus:</strong> Embed AI permanently into the college system — not just for NAAC, not just for a workshop, but as the college's permanent way of working. Annual AI Expo, AI Club, industry collaboration.</p>
          <p style="margin-top:8px;"><strong>Strategic Outcome:</strong> HKBK positioned as <em style="color:var(--gold);">"AI-Integrated Engineering College"</em> — differentiated in admissions, placements, NAAC, AICTE, and industry partnerships.</p>
          <div class="phase-deliverables">
            <span class="deliverable" style="border-color:rgba(244,196,48,.3);color:var(--gold);">AI Project Repository</span>
            <span class="deliverable" style="border-color:rgba(244,196,48,.3);color:var(--gold);">Annual AI Expo</span>
            <span class="deliverable" style="border-color:rgba(244,196,48,.3);color:var(--gold);">AI Club / AI Lab</span>
            <span class="deliverable" style="border-color:rgba(244,196,48,.3);color:var(--gold);">Industry Collaboration</span>
            <span class="deliverable" style="border-color:rgba(244,196,48,.3);color:var(--gold);">NAAC Documentation Ready</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Strategic point -->
    <div style="margin-top:40px;background:rgba(244,196,48,.06);border:1px solid rgba(244,196,48,.2);border-radius:16px;padding:32px;">
      <h3 style="font-family:'Space Grotesk',sans-serif;color:var(--gold);margin-bottom:16px;font-size:20px;">💡 The Strategic Positioning Opportunity</h3>
      <p style="font-size:15px;color:var(--grey2);line-height:1.8;">If this transformation succeeds, HKBK will be positioned as an <strong style="color:var(--white);">"AI-Integrated Engineering College"</strong> — a designation that creates competitive advantages in <strong style="color:var(--gold);">Admissions</strong> (students and parents choose AI-ready colleges), <strong style="color:var(--gold);">Placements</strong> (companies prefer graduates with AI skills), <strong style="color:var(--gold);">NAAC</strong> (AI-integrated curriculum scores higher), <strong style="color:var(--gold);">AICTE</strong> (nodal center status and funding), and <strong style="color:var(--gold);">Industry Collaboration</strong> (AI-ready campus attracts partnerships). This is not just academic improvement — this is an institutional transformation strategy.</p>
    </div>
  </div>
</section>

<!-- ════════════════════════ SKILLS ════════════════════════ -->
<section id="skills" class="section">
  <div class="sec-wrap">
    <div class="sec-header">
      <div class="sec-tag">🎯 Capabilities</div>
      <h2 class="sec-title">Skills & <span>Competencies</span></h2>
      <p class="sec-desc">AI skills being built across faculty, students, and leadership at HKBK — updated as we grow.</p>
    </div>

    <!-- ── EASY TO UPDATE: Edit SKILLS_DATA in the script below ── -->
    <div id="skills-filter" style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-bottom:28px;"></div>
    <div id="skills-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;"></div>

  </div>
</section>

