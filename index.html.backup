                  <span style="font-size:11px;font-weight:800;letter-spacing:2px;color:var(--cyan);text-transform:uppercase;">Project 01 · EV / Power Electronics</span>
                  <span style="background:rgba(34,197,94,.15);color:#22c55e;font-size:10px;font-weight:700;padding:3px 10px;border-radius:20px;border:1px solid rgba(34,197,94,.3);">🟢 In Progress</span>
                </div>
                <h4 style="font-family:'Space Grotesk',sans-serif;font-size:18px;font-weight:700;margin-bottom:4px;">⚡ EV Charging Infrastructure</h4>
