          <span style="background:rgba(255,255,255,.06);color:var(--grey2);border:1px solid rgba(255,255,255,.1);font-size:11px;padding:4px 10px;border-radius:8px;">🤖 Robotics</span>
          <span style="background:rgba(255,255,255,.06);color:var(--grey2);border:1px solid rgba(255,255,255,.1);font-size:11px;padding:4px 10px;border-radius:8px;">🚁 Drone Lab</span>
          <span style="background:rgba(255,255,255,.06);color:var(--grey2);border:1px solid rgba(255,255,255,.1);font-size:11px;padding:4px 10px;border-radius:8px;">⚛️ Quantum Terminal</span>
