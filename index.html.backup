          <span style="background:rgba(249,115,22,.1);color:#fdba74;border:1px solid rgba(249,115,22,.25);font-size:11px;padding:4px 10px;border-radius:8px;">⚙️ CNC Machine</span>
          <span style="background:rgba(255,255,255,.06);color:var(--grey2);border:1px solid rgba(255,255,255,.1);font-size:11px;padding:4px 10px;border-radius:8px;">🖨️ 3D Printers</span>
          <span style="background:rgba(139,92,246,.1);color:#c4b5fd;border:1px solid rgba(139,92,246,.25);font-size:11px;padding:4px 10px;border-radius:8px;">🧩 Design Thinking</span>
