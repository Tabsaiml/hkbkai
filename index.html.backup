            <div style="background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;transition:all .3s;" onmouseover="this.style.borderColor='#f4c430';this.style.transform='translateY(-4px)'" onmouseout="this.style.borderColor='rgba(0,180,216,0.2)';this.style.transform='translateY(0)'">
              <div style="background:linear-gradient(135deg,rgba(244,196,48,.12),rgba(255,107,107,.08));padding:20px;border-bottom:1px solid rgba(255,255,255,.06);">
