<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>HKBK AI Transformation Journey 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root {
    --navy:    #050e1f;
    --navy2:   #0a1628;
    --navy3:   #0f2040;
    --cyan:    #00b4d8;
    --cyan2:   #90e0ef;
    --gold:    #f4c430;
    --green:   #22c55e;
    --coral:   #ff6b6b;
    --purple:  #8b5cf6;
    --white:   #ffffff;
    --grey:    #94a3b8;
    --grey2:   #ccd6e0;
    --card:    #0d1f35;
    --border:  rgba(0,180,216,0.2);
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html { scroll-behavior: smooth; }
  body { font-family:'Inter',sans-serif; background:var(--navy); color:var(--white); overflow-x:hidden; }

  /* ── NAVBAR ── */
  .navbar {
    position:fixed; top:0; left:0; right:0; z-index:1000;
    background:rgba(5,14,31,.95); backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border);
    display:flex; align-items:center; justify-content:space-between;
    padding:0 24px; height:64px; gap:16px; overflow:visible;
  }
  .nav-brand { display:flex; align-items:center; gap:10px; flex-shrink:0; min-width:0; }
  .nav-logo {
    width:36px; height:36px; min-width:36px; background:linear-gradient(135deg,var(--cyan),var(--purple));
    border-radius:8px; display:flex; align-items:center; justify-content:center;
    font-size:18px; flex-shrink:0;
  }
  .nav-brand-text { font-family:'Space Grotesk',sans-serif; font-size:15px; font-weight:700; color:var(--white); line-height:1.2; white-space:nowrap; }
  .nav-brand-sub { font-size:11px; color:var(--cyan); font-weight:500; white-space:nowrap; }
  .nav-tabs { display:flex; gap:4px; flex-shrink:1; overflow-x:auto; scrollbar-width:none; }
  .nav-tabs::-webkit-scrollbar { display:none; }
  .nav-tab {
    padding:7px 14px; border-radius:6px; font-size:13px; font-weight:500;
    color:var(--grey); cursor:pointer; border:none; background:transparent;
    transition:all .2s; white-space:nowrap;
  }
  .nav-tab:hover { color:var(--white); background:rgba(255,255,255,.07); }
  .nav-tab.active { color:var(--cyan); background:rgba(0,180,216,.12); }
  .nav-badge {
    display:inline-block; background:var(--gold); color:var(--navy);
    font-size:9px; font-weight:800; padding:1px 5px; border-radius:4px; margin-left:5px;
    vertical-align:middle;
  }

  /* ── SECTIONS ── */
  .section { display:none; padding-top:64px; }
  .section.active { display:block; }

  /* ── HERO ── */
  .hero {
    min-height:100vh; display:flex; align-items:center; justify-content:center;
    background: radial-gradient(ellipse at 20% 50%, rgba(0,180,216,.15) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 20%, rgba(139,92,246,.15) 0%, transparent 60%),
                radial-gradient(ellipse at 60% 80%, rgba(244,196,48,.08) 0%, transparent 50%),
                var(--navy);
    position:relative; overflow:hidden; padding:40px 24px;
  }
  .hero-grid {
    position:absolute; inset:0; opacity:.04;
    background-image: linear-gradient(var(--cyan) 1px,transparent 1px),
                      linear-gradient(90deg,var(--cyan) 1px,transparent 1px);
    background-size:60px 60px;
  }
  .hero-content { text-align:center; max-width:900px; position:relative; }
  .hero-badge {
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(244,196,48,.12); border:1px solid rgba(244,196,48,.3);
    color:var(--gold); padding:8px 20px; border-radius:50px; font-size:13px;
    font-weight:600; margin-bottom:28px; letter-spacing:.5px;
  }
  .hero-badge span { font-size:16px; }
  .hero-title {
    font-family:'Space Grotesk',sans-serif; font-size:clamp(36px,6vw,72px);
    font-weight:800; line-height:1.1; margin-bottom:16px;
  }
  .hero-title .line1 { display:block; color:var(--white); }
  .hero-title .line2 { display:block; background:linear-gradient(135deg,var(--cyan),var(--purple)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .hero-sub {
    font-size:clamp(15px,2vw,19px); color:var(--grey2); margin-bottom:12px;
    font-weight:400; line-height:1.7;
  }
  .hero-college { font-size:14px; color:var(--cyan); font-weight:600; margin-bottom:40px; letter-spacing:.5px; }
  .hero-resolution {
    background:rgba(0,180,216,.08); border:1px solid var(--border);
    border-radius:16px; padding:28px 36px; margin-bottom:40px;
    display:inline-block;
  }
  .hero-resolution h3 { color:var(--gold); font-size:13px; font-weight:700; letter-spacing:2px; text-transform:uppercase; margin-bottom:14px; }
  .hero-resolution p { font-size:18px; color:var(--white); font-weight:600; line-height:1.6; }
  .hero-resolution p em { color:var(--cyan); font-style:normal; }
  .hero-stats { display:flex; gap:32px; justify-content:center; flex-wrap:wrap; }
  .hero-stat { text-align:center; }
  .hero-stat-num { font-family:'Space Grotesk',sans-serif; font-size:36px; font-weight:800; color:var(--cyan); line-height:1; }
  .hero-stat-lbl { font-size:12px; color:var(--grey); margin-top:4px; font-weight:500; }
  .scroll-hint { position:absolute; bottom:32px; left:50%; transform:translateX(-50%); color:var(--grey); font-size:12px; display:flex; flex-direction:column; align-items:center; gap:6px; animation:bounce 2s infinite; }
  @keyframes bounce { 0%,100%{transform:translateX(-50%) translateY(0)} 50%{transform:translateX(-50%) translateY(8px)} }

  /* ── SECTION CONTAINER ── */
  .sec-wrap { max-width:1200px; margin:0 auto; padding:60px 24px; }
  .sec-header { text-align:center; margin-bottom:56px; }
  .sec-tag { display:inline-block; background:rgba(0,180,216,.12); border:1px solid var(--border); color:var(--cyan); font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; padding:6px 16px; border-radius:50px; margin-bottom:16px; }
  .sec-title { font-family:'Space Grotesk',sans-serif; font-size:clamp(28px,4vw,44px); font-weight:800; margin-bottom:14px; }
  .sec-title span { background:linear-gradient(135deg,var(--cyan),var(--purple)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .sec-desc { font-size:16px; color:var(--grey); max-width:640px; margin:0 auto; line-height:1.7; }

  /* ── TIMELINE ── */
  .timeline { position:relative; padding:20px 0; }
  .timeline::before { content:''; position:absolute; left:28px; top:0; bottom:0; width:2px; background:linear-gradient(to bottom,transparent,var(--cyan),transparent); }
  .tl-item { display:grid; grid-template-columns:52px 1fr 340px; gap:24px; margin-bottom:48px; align-items:flex-start; }
  .tl-content { flex:1; }
  .tl-dot-wrap { flex:0 0 auto; display:flex; flex-direction:column; align-items:center; position:relative; z-index:2; }
  .tl-dot {
    width:52px; height:52px; border-radius:50%;
    background:linear-gradient(135deg,var(--cyan),var(--purple));
    display:flex; align-items:center; justify-content:center;
    font-size:22px; box-shadow:0 0 20px rgba(0,180,216,.4);
    flex-shrink:0;
  }
  .tl-card {
    background:var(--card); border:1px solid var(--border); border-radius:16px;
    padding:28px; transition:transform .3s, box-shadow .3s;
  }
  .tl-card:hover { transform:translateY(-4px); box-shadow:0 12px 40px rgba(0,180,216,.15); }
  .tl-month { font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:var(--cyan); margin-bottom:8px; }
  .tl-card h3 { font-family:'Space Grotesk',sans-serif; font-size:20px; font-weight:700; margin-bottom:12px; }
  .tl-card p { color:var(--grey2); font-size:14px; line-height:1.7; margin-bottom:14px; }
  .tl-card ul { list-style:none; }
  .tl-card ul li { color:var(--grey2); font-size:13px; padding:4px 0; display:flex; align-items:flex-start; gap:8px; }
  .tl-card ul li::before { content:'▸'; color:var(--cyan); flex-shrink:0; margin-top:1px; }
  /* right-side photo column — 2×3 grid */
  .tl-photos-col {
    display:grid; grid-template-columns:1fr 1fr; gap:8px; padding-top:4px; align-content:start;
  }
  .tl-photo-slot {
    width:100%; aspect-ratio:1/1; border-radius:10px;
    border:1.5px dashed rgba(0,180,216,.4);
    background:linear-gradient(135deg,rgba(0,180,216,.05),rgba(139,92,246,.05));
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:3px; cursor:pointer; transition:all .25s; overflow:hidden; position:relative;
  }
  .tl-photo-slot:hover { border-color:var(--cyan); background:rgba(0,180,216,.1); transform:scale(1.02); }
  .tl-photo-slot img { width:100%; height:100%; object-fit:cover; border-radius:8px; position:absolute; inset:0; }
  .tl-photo-slot .ph-icon { font-size:20px; opacity:.7; }
  .tl-photo-slot .ph-label { font-size:9.5px; font-weight:600; color:var(--cyan); text-align:center; padding:0 6px; line-height:1.3; }
  .tl-photo-slot .ph-hint { font-size:8.5px; color:var(--grey); text-align:center; opacity:.8; }

  .tl-photos { display:grid; grid-template-columns:repeat(auto-fill,minmax(120px,1fr)); gap:8px; margin-top:16px; }
  .tl-photo { width:100%; aspect-ratio:4/3; border-radius:8px; object-fit:cover; border:1px solid var(--border); }
  .tl-photo-placeholder {
    width:100%; aspect-ratio:4/3; border-radius:8px; background:rgba(0,180,216,.06);
    border:1px dashed rgba(0,180,216,.3); display:flex; flex-direction:column;
    align-items:center; justify-content:center; color:var(--grey); font-size:11px; gap:4px;
  }
  .achievement-badge {
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(244,196,48,.1); border:1px solid rgba(244,196,48,.3);
    color:var(--gold); padding:8px 14px; border-radius:8px;
    font-size:13px; font-weight:600; margin-top:12px;
  }

  /* ── LAYERS ── */
  .layers-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:24px; }
  .layer-card {
    background:var(--card); border:1px solid var(--border); border-radius:20px;
    padding:32px; position:relative; overflow:hidden; transition:all .3s;
  }
  .layer-card:hover { transform:translateY(-6px); box-shadow:0 20px 50px rgba(0,0,0,.4); }
  .layer-card::before {
    content:''; position:absolute; top:0; left:0; right:0; height:3px;
  }
  .layer-card.l1::before { background:linear-gradient(90deg,#22c55e,#16a34a); }
  .layer-card.l2::before { background:linear-gradient(90deg,#00b4d8,#0284c7); }
  .layer-card.l3::before { background:linear-gradient(90deg,#8b5cf6,#6d28d9); }
  .layer-card.l4::before { background:linear-gradient(90deg,#f4c430,#d97706); }
  .layer-card.l5::before { background:linear-gradient(90deg,#ff6b6b,#dc2626); }
  .layer-num { font-size:11px; font-weight:800; letter-spacing:3px; text-transform:uppercase; margin-bottom:12px; }
  .l1 .layer-num { color:#22c55e; }
  .l2 .layer-num { color:#00b4d8; }
  .l3 .layer-num { color:#8b5cf6; }
  .l4 .layer-num { color:#f4c430; }
  .l5 .layer-num { color:#ff6b6b; }
  .layer-icon { font-size:36px; margin-bottom:16px; }
  .layer-card h3 { font-family:'Space Grotesk',sans-serif; font-size:20px; font-weight:700; margin-bottom:8px; }
  .layer-card .layer-sub { font-size:13px; color:var(--grey); margin-bottom:16px; font-weight:500; }
  .layer-card ul { list-style:none; }
  .layer-card ul li { font-size:13px; color:var(--grey2); padding:5px 0; display:flex; align-items:flex-start; gap:8px; border-bottom:1px solid rgba(255,255,255,.04); }
  .layer-card ul li:last-child { border-bottom:none; }
  .layer-card ul li::before { content:'●'; font-size:6px; margin-top:6px; flex-shrink:0; }
  .l1 ul li::before { color:#22c55e; }
  .l2 ul li::before { color:#00b4d8; }
  .l3 ul li::before { color:#8b5cf6; }
  .l4 ul li::before { color:#f4c430; }
  .l5 ul li::before { color:#ff6b6b; }
  .layer-status { display:inline-block; padding:4px 12px; border-radius:20px; font-size:11px; font-weight:700; margin-top:16px; }
  .status-active { background:rgba(34,197,94,.15); color:#22c55e; border:1px solid rgba(34,197,94,.3); }
  .status-inprogress { background:rgba(0,180,216,.15); color:var(--cyan); border:1px solid var(--border); }
  .status-upcoming { background:rgba(148,163,184,.1); color:var(--grey); border:1px solid rgba(148,163,184,.2); }

  /* ── VISION ── */
  .vision-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(320px,1fr)); gap:32px; }
  .vision-card {
    background:var(--card); border:1px solid var(--border); border-radius:24px;
    padding:36px; display:flex; flex-direction:column; gap:20px;
    transition:all .3s; position:relative; overflow:hidden;
  }
  .vision-card:hover { border-color:var(--cyan); box-shadow:0 16px 48px rgba(0,180,216,.12); }
  .vision-card::after { content:''; position:absolute; top:-80px; right:-80px; width:200px; height:200px; background:radial-gradient(circle,rgba(0,180,216,.06),transparent 70%); pointer-events:none; }
  .vision-person { display:flex; align-items:center; gap:16px; }
  .vision-photo {
    width:80px; height:80px; border-radius:50%;
    border:2px solid var(--cyan); object-fit:cover; flex-shrink:0;
  }
  .vision-photo-placeholder {
    width:80px; height:80px; border-radius:50%;
    border:2px dashed rgba(0,180,216,.4);
    background:rgba(0,180,216,.06);
    display:flex; align-items:center; justify-content:center;
    font-size:28px; flex-shrink:0;
  }
  .vision-info h3 { font-family:'Space Grotesk',sans-serif; font-size:18px; font-weight:700; margin-bottom:4px; }
  .vision-info .role { font-size:12px; color:var(--cyan); font-weight:600; letter-spacing:.5px; }
  .vision-info .dept { font-size:12px; color:var(--grey); margin-top:2px; }
  .vision-quote { font-size:22px; color:var(--cyan); }
  .vision-text { font-size:14px; color:var(--grey2); line-height:1.8; font-style:italic; }
  .vision-highlights { display:flex; flex-direction:column; gap:8px; }
  .vision-highlight { display:flex; align-items:flex-start; gap:10px; background:rgba(255,255,255,.03); border-radius:8px; padding:10px 12px; }
  .vision-highlight .hi-icon { font-size:16px; flex-shrink:0; }
  .vision-highlight p { font-size:13px; color:var(--grey2); line-height:1.5; }

  /* ── PORTALS ── */
  .portals-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:24px; }
  .portal-card {
    background:var(--card); border:1px solid var(--border); border-radius:20px;
    padding:28px; display:flex; flex-direction:column; gap:16px;
    transition:all .3s; cursor:pointer;
  }
  .portal-card:hover { border-color:var(--cyan); transform:translateY(-4px); box-shadow:0 16px 40px rgba(0,0,0,.3); }
  .portal-icon { font-size:40px; }
  .portal-card h3 { font-family:'Space Grotesk',sans-serif; font-size:18px; font-weight:700; }
  .portal-card p { font-size:13px; color:var(--grey); line-height:1.7; flex:1; }
  .portal-link {
    display:inline-flex; align-items:center; gap:6px;
    background:rgba(0,180,216,.1); border:1px solid var(--border);
    color:var(--cyan); padding:8px 16px; border-radius:8px; font-size:13px;
    font-weight:600; text-decoration:none; transition:all .2s;
  }
  .portal-link:hover { background:rgba(0,180,216,.2); }
  .portal-tag { display:inline-block; background:rgba(34,197,94,.1); color:#22c55e; font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; padding:3px 10px; border-radius:4px; }

  /* ── INFRASTRUCTURE ── */
  .infra-tabs { display:flex; gap:8px; margin-bottom:32px; flex-wrap:wrap; }
  .infra-tab { padding:10px 20px; border-radius:8px; font-size:13px; font-weight:600; cursor:pointer; border:1px solid var(--border); color:var(--grey); background:transparent; transition:all .2s; }
  .infra-tab.active, .infra-tab:hover { border-color:var(--cyan); color:var(--cyan); background:rgba(0,180,216,.08); }
  .infra-panels > div { display:none; }
  .infra-panels > div.active { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:20px; }
  .infra-item {
    background:rgba(255,255,255,.03); border:1px solid rgba(255,255,255,.07);
    border-radius:14px; padding:22px; display:flex; flex-direction:column; gap:12px;
    transition:all .2s;
  }
  .infra-item:hover { border-color:var(--border); background:var(--card); }
  .infra-item-icon { font-size:32px; }
  .infra-item h4 { font-size:15px; font-weight:700; }
  .infra-item p { font-size:13px; color:var(--grey); line-height:1.6; }

  /* ── ACHIEVEMENTS ── */
  .achieve-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:24px; }
  .achieve-card {
    background:var(--card); border:1px solid var(--border); border-radius:16px;
    padding:28px; text-align:center; transition:all .3s;
  }
  .achieve-card:hover { transform:translateY(-4px); border-color:var(--gold); box-shadow:0 12px 40px rgba(244,196,48,.1); }
  .achieve-icon { font-size:48px; margin-bottom:16px; }
  .achieve-card h3 { font-size:16px; font-weight:700; margin-bottom:8px; }
  .achieve-card p { font-size:13px; color:var(--grey); line-height:1.6; }
  .achieve-date { font-size:11px; color:var(--gold); font-weight:700; letter-spacing:1px; text-transform:uppercase; margin-top:12px; }
  .achieve-photo-placeholder {
    width:100%; height:140px; border-radius:10px; margin-top:16px;
    background:rgba(244,196,48,.05); border:1px dashed rgba(244,196,48,.3);
    display:flex; align-items:center; justify-content:center;
    color:var(--grey); font-size:12px; flex-direction:column; gap:4px;
  }

  /* ── ROADMAP ── */
  .roadmap-phases { display:flex; flex-direction:column; gap:4px; }
  .phase-row {
    display:flex; align-items:stretch; border-radius:12px; overflow:hidden;
    border:1px solid var(--border); background:var(--card);
    transition:all .3s;
  }
  .phase-row:hover { border-color:var(--cyan); }
  .phase-label {
    width:160px; flex-shrink:0; background:rgba(0,180,216,.08);
    padding:20px; display:flex; flex-direction:column; justify-content:center;
    border-right:1px solid var(--border);
  }
  .phase-label .phase-num { font-size:11px; font-weight:700; color:var(--cyan); letter-spacing:2px; text-transform:uppercase; }
  .phase-label h4 { font-size:14px; font-weight:700; margin-top:4px; }
  .phase-label .phase-period { font-size:11px; color:var(--grey); margin-top:4px; }
  .phase-body { flex:1; padding:20px; }
  .phase-body p { font-size:13px; color:var(--grey2); line-height:1.7; }
  .phase-deliverables { display:flex; gap:8px; flex-wrap:wrap; margin-top:12px; }
  .deliverable { background:rgba(0,180,216,.08); border:1px solid rgba(0,180,216,.15); color:var(--cyan2); font-size:11px; padding:4px 10px; border-radius:20px; font-weight:500; }

  /* ── FOOTER ── */
  footer {
    background:rgba(0,0,0,.4); border-top:1px solid var(--border);
    padding:40px 24px; text-align:center; color:var(--grey); font-size:13px;
  }
  footer .footer-logo { font-family:'Space Grotesk',sans-serif; font-size:20px; font-weight:800; color:var(--white); margin-bottom:8px; }
  footer .footer-sub { color:var(--cyan); font-size:12px; margin-bottom:16px; }
  footer p { line-height:1.8; }

  /* ── RESPONSIVE ── */
  @media(max-width:768px) {
    .nav-tabs { display:none; }
    .timeline::before { left:24px; }
    .tl-item { grid-template-columns:40px 1fr; grid-template-rows:auto auto; }
    .tl-photos-col { grid-column:2; grid-row:2; grid-template-columns:1fr 1fr; }
    .tl-dot-wrap { align-items:flex-start; }
    .phase-label { width:120px; }
    .hero-stats { gap:20px; }
  }

  /* ── MOBILE NAV ── */
  .mob-menu-btn { display:none; background:transparent; border:none; color:var(--white); font-size:22px; cursor:pointer; }
  @media(max-width:768px) { .mob-menu-btn { display:block; } }
  .mob-nav {
    display:none; position:fixed; top:64px; left:0; right:0; z-index:999;
    background:rgba(5,14,31,.98); backdrop-filter:blur(12px);
    border-bottom:1px solid var(--border); padding:16px;
    flex-direction:column; gap:4px;
  }
  .mob-nav.open { display:flex; }
  .mob-nav .nav-tab { text-align:left; padding:12px 16px; font-size:14px; }

  /* ── PARTICLES CANVAS ── */
  #particles { position:absolute; inset:0; pointer-events:none; }

  /* ── COUNTER ANIMATION ── */
  @keyframes countUp { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
  .hero-stat-num { animation:countUp .6s ease forwards; }

  /* ── GLOW EFFECT ── */
  .glow { text-shadow:0 0 30px rgba(0,180,216,.5); }
  .glow-gold { text-shadow:0 0 20px rgba(244,196,48,.4); }

  /* ── PHOTO GALLERY ── */
  .gallery { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:10px; margin-top:20px; }
  .gallery img { width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:10px; border:1px solid var(--border); transition:all .3s; }
  .gallery img:hover { transform:scale(1.03); border-color:var(--cyan); }
</style>
</head>
